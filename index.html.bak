<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Coimbatore Smart Traffic Management and Emergency Vehicle Routing System - Intelligent traffic signals, automatic vehicle generation, Dijkstra routing, and green corridor priority.">
  <title>Coimbatore Smart Traffic Management & Emergency Vehicle Routing</title>

  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css" rel="stylesheet">

  <!-- Custom Design System -->
  <link href="css/style.css" rel="stylesheet">
</head>
<body>

  <!-- Top Sticky Navigation Bar -->
  <header class="navbar-custom">
    <div class="container-fluid d-flex align-items-center justify-content-between flex-wrap gap-2">
      <!-- Brand Title -->
      <div class="d-flex align-items-center gap-3">
        <button class="btn btn-outline-custom d-lg-none p-1 px-2" id="sidebarToggleBtn" onclick="document.querySelector('.app-sidebar').classList.toggle('show')">
          <i class="bi bi-list fs-5"></i>
        </button>
        <div class="brand-title">
          <span class="fs-4">🚦</span>
          <div>
            <span class="d-block text-white">Smart Traffic & Emergency Routing</span>
            <small class="text-muted fw-normal d-block" style="font-size: 0.75rem;">Coimbatore Municipal Traffic Simulation Grid</small>
          </div>
          <span class="brand-badge ms-2 d-none d-sm-inline-block">Java Core</span>
        </div>
      </div>

      <!-- Live Simulation Header Controls -->
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <div class="sim-controls-bar">
          <span id="simStatusBadge" class="status-indicator paused">
            <span class="pulse-dot"></span>
            PAUSED
          </span>
          <span id="simTickCounter" class="tick-counter">t=000</span>
          
          <select id="simSpeedSelect" class="form-select form-select-sm form-select-custom py-0 px-2" style="width: 80px; font-size: 0.8rem;" title="Simulation Speed">
            <option value="1">1x</option>
            <option value="2">2x</option>
            <option value="5">5x</option>
            <option value="10">10x</option>
          </select>

          <button id="btnSimStart" class="btn btn-sm btn-outline-custom text-success" title="Start / Resume Simulation">
            <i class="bi bi-play-fill"></i>
          </button>
          <button id="btnSimPause" class="btn btn-sm btn-outline-custom text-warning" title="Pause Simulation">
            <i class="bi bi-pause-fill"></i>
          </button>
          <button id="btnSimStep" class="btn btn-sm btn-outline-custom text-info" title="Step 1 Tick">
            <i class="bi bi-skip-end-fill"></i>
          </button>
          <button id="btnSimReset" class="btn btn-sm btn-outline-custom text-danger" title="Reset Simulation">
            <i class="bi bi-arrow-counterclockwise"></i>
          </button>
        </div>

        <!-- Backend Status Badge -->
        <div class="d-none d-md-block">
          <span id="backendStatusBadge" class="badge bg-primary cursor-pointer" title="Click to configure backend API connection">
            <i class="bi bi-cpu me-1"></i> Simulation Engine: ACTIVE
          </span>
        </div>
      </div>
    </div>
  </header>

  <div class="app-wrapper">
    <!-- Sidebar Navigation -->
    <aside class="app-sidebar">
      <div class="nav-section-title">Operations</div>
      <a class="nav-link-custom active" data-tab="dashboard">
        <i class="bi bi-speedometer2"></i>
        <span>Dashboard</span>
      </a>
      <a class="nav-link-custom" data-tab="network">
        <i class="bi bi-diagram-3"></i>
        <span>Traffic Network</span>
      </a>
      <a class="nav-link-custom" data-tab="routes">
        <i class="bi bi-geo-alt"></i>
        <span>Route Management</span>
      </a>
      <a class="nav-link-custom" data-tab="traffic">
        <i class="bi bi-car-front"></i>
        <span>Auto Traffic Gen</span>
      </a>

      <div class="nav-section-title">Emergency Core</div>
      <a class="nav-link-custom" data-tab="emergency">
        <i class="bi bi-shield-exclamation text-danger"></i>
        <span>Emergency Routing</span>
        <span class="nav-badge nav-badge-emergency">Priority</span>
      </a>
      <a class="nav-link-custom" data-tab="signals">
        <i class="bi bi-traffic-light"></i>
        <span>Signal Monitoring</span>
      </a>

      <div class="nav-section-title">Telemetry & Audit</div>
      <a class="nav-link-custom" data-tab="events">
        <i class="bi bi-clock-history"></i>
        <span>Traffic Events</span>
      </a>
      <a class="nav-link-custom" data-tab="reports">
        <i class="bi bi-bar-chart-line"></i>
        <span>Reports & Tests</span>
      </a>

      <div class="mt-auto pt-3 border-top border-secondary border-opacity-25">
        <div class="px-2 py-1 text-muted" style="font-size: 0.75rem;">
          <div><i class="bi bi-pin-map-fill me-1 text-info"></i> 12 Coimbatore Nodes</div>
          <div class="mt-1"><i class="bi bi-bezier2 me-1 text-info"></i> 17 Road Segments</div>
          <div class="mt-1"><i class="bi bi-check2-circle me-1 text-success"></i> Dijkstra Min-Heap</div>
        </div>
      </div>
    </aside>

    <!-- Main Content Body -->
    <main class="app-content">
      <!-- Backend Status Connection Banner -->
      <div id="backendStatusBanner" class="backend-banner cursor-pointer" title="Click to configure backend connection">
        <div>
          <i class="bi bi-cpu text-info me-2"></i>
          <strong>In-Browser Simulation Engine (Java Parity):</strong> Full Dijkstra, Signal Phase Machine, and FIFO Priority active.
        </div>
        <button class="btn btn-sm btn-outline-primary">Connect Spring Boot</button>
      </div>

      <!-- ====================================================================
           TAB 1: DASHBOARD
           ==================================================================== -->
      <section id="view-dashboard" class="tab-view">
        <!-- Top KPI Row -->
        <div class="row g-3 mb-4">
          <div class="col-12 col-sm-6 col-xl-2">
            <div class="metric-card">
              <div class="metric-card-icon"><i class="bi bi-car-front-fill"></i></div>
              <div class="metric-label">Total Vehicles</div>
              <div id="dashTotalVehicles" class="metric-value">0</div>
              <div class="metric-sub">Processed & active</div>
            </div>
          </div>
          <div class="col-12 col-sm-6 col-xl-2">
            <div class="metric-card emergency">
              <div class="metric-card-icon"><i class="bi bi-hospital"></i></div>
              <div class="metric-label">Active Emergencies</div>
              <div id="dashActiveEmergencies" class="metric-value">0</div>
              <div class="metric-sub">Green corridors active</div>
            </div>
          </div>
          <div class="col-12 col-sm-6 col-xl-2">
            <div class="metric-card">
              <div class="metric-card-icon"><i class="bi bi-geo-alt-fill"></i></div>
              <div class="metric-label">Junction Count</div>
              <div id="dashJunctionCount" class="metric-value">12</div>
              <div class="metric-sub">Coimbatore City Hubs</div>
            </div>
          </div>
          <div class="col-12 col-sm-6 col-xl-2">
            <div class="metric-card warning">
              <div class="metric-card-icon"><i class="bi bi-hourglass-split"></i></div>
              <div class="metric-label">Emergency Queue</div>
              <div id="dashEmergencyQueueCount" class="metric-value">0</div>
              <div class="metric-sub">FIFO Conflict Queue</div>
            </div>
          </div>
          <div class="col-12 col-sm-6 col-xl-2">
            <div class="metric-card success">
              <div class="metric-card-icon"><i class="bi bi-speedometer"></i></div>
              <div class="metric-label">Avg Travel Time</div>
              <div id="dashAvgTravelTime" class="metric-value">--</div>
              <div class="metric-sub">Simulation ticks</div>
            </div>
          </div>
          <div class="col-12 col-sm-6 col-xl-2">
            <div class="metric-card">
              <div class="metric-card-icon"><i class="bi bi-stoplights"></i></div>
              <div class="metric-label">Signal Wait Time</div>
              <div id="dashAvgWaitTime" class="metric-value">--</div>
              <div class="metric-sub">Normal vs Emergency</div>
            </div>
          </div>
        </div>

        <!-- Middle Row: Interactive Map Snapshot + Emergency Request Queue -->
        <div class="row g-4 mb-4">
          <div class="col-12 col-lg-7">
            <div class="card-glass h-100">
              <div class="card-glass-header">
                <h5 class="card-glass-title">
                  <i class="bi bi-diagram-3-fill text-info"></i>
                  Coimbatore Traffic Grid Live Network
                </h5>
                <button class="btn btn-sm btn-outline-custom" onclick="App.switchTab('network')">
                  Expand View <i class="bi bi-arrows-fullscreen ms-1"></i>
                </button>
              </div>
              <div class="card-glass-body p-2">
                <div id="dashMiniMapContainer" class="network-container"></div>
              </div>
            </div>
          </div>

          <div class="col-12 col-lg-5">
            <div class="card-glass h-100">
              <div class="card-glass-header">
                <h5 class="card-glass-title">
                  <i class="bi bi-shield-exclamation text-danger"></i>
                  Active Emergency Request Queue (FIFO)
                </h5>
                <button class="btn btn-sm btn-outline-custom" onclick="App.switchTab('emergency')">
                  Dispatch New <i class="bi bi-plus ms-1"></i>
                </button>
              </div>
              <div class="card-glass-body p-0" id="dashEmergencyQueueBody">
                <!-- Dynamically populated -->
              </div>
            </div>
          </div>
        </div>

        <!-- Bottom Row: Active Vehicles & Live Event Stream -->
        <div class="row g-4">
          <div class="col-12 col-lg-7">
            <div class="card-glass">
              <div class="card-glass-header">
                <h5 class="card-glass-title">
                  <i class="bi bi-car-front text-primary"></i>
                  Active En-Route Vehicles
                </h5>
                <button class="btn btn-sm btn-outline-custom" onclick="App.switchTab('traffic')">
                  View All Tracking
                </button>
              </div>
              <div class="card-glass-body p-0" id="dashActiveVehiclesBody">
                <!-- Dynamically populated -->
              </div>
            </div>
          </div>

          <div class="col-12 col-lg-5">
            <div class="card-glass">
              <div class="card-glass-header">
                <h5 class="card-glass-title">
                  <i class="bi bi-clock-history text-warning"></i>
                  Recent Traffic & Signal Events
                </h5>
                <button class="btn btn-sm btn-outline-custom" onclick="App.switchTab('events')">
                  Event Log
                </button>
              </div>
              <div class="card-glass-body p-0" id="dashRecentEventsList" style="max-height: 380px; overflow-y: auto;">
                <!-- Dynamically populated -->
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ====================================================================
           TAB 2: COIMBATORE TRAFFIC NETWORK
           ==================================================================== -->
      <section id="view-network" class="tab-view d-none">
        <div class="card-glass mb-4">
          <div class="card-glass-header flex-wrap gap-2">
            <div>
              <h4 class="card-glass-title text-white">
                <i class="bi bi-diagram-3-fill text-info"></i>
                Coimbatore Road Network Topology (12 Junctions, 17 Roads)
              </h4>
              <p class="text-muted small mb-0 mt-1">
                Interactive schematic representation mapping Gandhipuram, Ukkadam, Singanallur, Peelamedu, RS Puram, Saibaba Colony, Town Hall, Race Course, Saravanampatti, Ganapathy, Hope College, and Ramanathapuram.
              </p>
            </div>
            <!-- Legend Badges -->
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <span class="badge" style="background: #2a6f97;">Light Traffic (1.0x)</span>
              <span class="badge" style="background: #d4a373;">Moderate (1.5x)</span>
              <span class="badge" style="background: #e76f51;">Heavy (2.5x)</span>
              <span class="badge bg-danger">Closed Road</span>
              <span class="badge bg-primary">Emergency Corridor</span>
            </div>
          </div>
          <div class="card-glass-body">
            <div class="network-container" id="networkSvgContainer">
              <!-- SVG Road Network rendered by NetworkView.js -->
            </div>
            <div class="d-flex justify-content-between align-items-center mt-3 text-muted small flex-wrap gap-2">
              <div>
                <i class="bi bi-info-circle me-1"></i>
                <strong>Tip:</strong> Click on any <strong>Road</strong> to toggle closure or change traffic level. Click any <strong>Junction</strong> to inspect signal state.
              </div>
              <button class="btn btn-sm btn-outline-custom" onclick="NetworkView.clearHighlight()">
                <i class="bi bi-eraser me-1"></i> Clear Route Highlight
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- ====================================================================
           TAB 3: ROUTE MANAGEMENT (Dijkstra Router)
           ==================================================================== -->
      <section id="view-routes" class="tab-view d-none">
        <div class="row g-4">
          <!-- Route Form -->
          <div class="col-12 col-lg-5">
            <div class="card-glass">
              <div class="card-glass-header">
                <h5 class="card-glass-title">
                  <i class="bi bi-signpost-split text-info"></i>
                  Find Shortest Route (Dijkstra Min-Heap)
                </h5>
              </div>
              <div class="card-glass-body">
                <div id="routeErrorMessage" class="alert alert-danger d-none py-2 mb-3"></div>

                <div class="mb-3">
                  <label class="form-label form-label-custom">Vehicle Type</label>
                  <select id="routeVehicleTypeSelect" class="form-select form-select-custom">
                    <option value="NORMAL">Normal Vehicle (Car / Bus)</option>
                    <option value="AMBULANCE">Ambulance (Emergency Priority)</option>
                    <option value="FIRE_TRUCK">Fire Truck (Emergency Priority)</option>
                    <option value="POLICE">Police Vehicle (Emergency Priority)</option>
                  </select>
                  <small class="text-muted" style="font-size: 0.75rem;">Emergency vehicles automatically request signal preemption corridors.</small>
                </div>

                <div class="mb-3">
                  <label class="form-label form-label-custom">Source Junction</label>
                  <select id="routeSourceSelect" class="form-select form-select-custom"></select>
                </div>

                <div class="mb-3">
                  <label class="form-label form-label-custom">Destination Junction</label>
                  <select id="routeDestSelect" class="form-select form-select-custom"></select>
                </div>

                <button id="btnFindRoute" class="btn btn-primary-custom w-100 py-2">
                  <i class="bi bi-search me-1"></i> Calculate Optimal Route
                </button>
              </div>
            </div>
          </div>

          <!-- Route Calculation Results -->
          <div class="col-12 col-lg-7">
            <div id="routeResultCard" class="card-glass d-none">
              <div class="card-glass-header">
                <h5 class="card-glass-title text-success">
                  <i class="bi bi-check2-circle"></i>
                  Calculated Optimal Route
                </h5>
                <button id="btnDispatchRouteVehicle" class="btn btn-sm btn-success">
                  <i class="bi bi-send-fill me-1"></i> Dispatch Vehicle Now
                </button>
              </div>
              <div class="card-glass-body">
                <div class="row g-3 mb-3">
                  <div class="col-4">
                    <div class="p-2 rounded bg-dark border border-secondary text-center">
                      <small class="text-muted d-block">Vehicle Type</small>
                      <strong id="resVehicleType" class="text-white">NORMAL</strong>
                    </div>
                  </div>
                  <div class="col-4">
                    <div class="p-2 rounded bg-dark border border-secondary text-center">
                      <small class="text-muted d-block">Total Distance</small>
                      <strong id="resDistance" class="text-info">0 km</strong>
                    </div>
                  </div>
                  <div class="col-4">
                    <div class="p-2 rounded bg-dark border border-secondary text-center">
                      <small class="text-muted d-block">Est. Travel Time</small>
                      <strong id="resEstTime" class="text-success">0 ticks</strong>
                    </div>
                  </div>
                </div>

                <!-- Step-by-Step Corridor Display -->
                <div class="mb-3">
                  <label class="form-label form-label-custom">Corridor Sequence</label>
                  <div id="resCorridorSteps" class="corridor-flow"></div>
                </div>

                <!-- Segments Breakdown -->
                <div>
                  <label class="form-label form-label-custom">Road Segments Breakdown</label>
                  <div class="table-responsive">
                    <table class="table-custom">
                      <thead>
                        <tr>
                          <th>#</th>
                          <th>Segment</th>
                          <th>Distance</th>
                          <th>Base Speed</th>
                          <th>Traffic Condition</th>
                          <th>Cost</th>
                        </tr>
                      </thead>
                      <tbody id="resRouteSegmentsTable"></tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ====================================================================
           TAB 4: AUTOMATIC TRAFFIC GENERATION
           ==================================================================== -->
      <section id="view-traffic" class="tab-view d-none">
        <div class="card-glass mb-4">
          <div class="card-glass-header">
            <h5 class="card-glass-title">
              <i class="bi bi-cpu text-info"></i>
              Automatic Traffic Scheduling Engine
            </h5>
          </div>
          <div class="card-glass-body">
            <div class="row g-3 align-items-end mb-3">
              <div class="col-12 col-md-5">
                <label class="form-label form-label-custom">Simulation Traffic Mode</label>
                <select id="trafficModeSelect" class="form-select form-select-custom">
                  <option value="1">1. Standard Demonstration Schedule (6 Staggered Vehicles)</option>
                  <option value="2">2. Randomized Traffic Generation (Custom 3-10 Vehicles)</option>
                </select>
              </div>

              <div class="col-12 col-md-4" id="randomCountRow" style="display: none;">
                <label class="form-label form-label-custom">Vehicle Count (3 - 10)</label>
                <input type="number" id="randomVehicleCountInput" class="form-control form-control-custom" min="3" max="10" value="6">
              </div>

              <div class="col-12 col-md-3">
                <button id="btnGenerateTraffic" class="btn btn-primary-custom w-100">
                  <i class="bi bi-shuffle me-1"></i> Generate & Schedule
                </button>
              </div>
            </div>

            <!-- Scheduled Vehicles Table -->
            <h6 class="form-label-custom mt-4 mb-2">Scheduled Vehicle Batch</h6>
            <div class="table-responsive mb-4">
              <table class="table-custom">
                <thead>
                  <tr>
                    <th>No.</th>
                    <th>Departure (t)</th>
                    <th>ID</th>
                    <th>Origin &rarr; Destination</th>
                    <th>Calculated Route</th>
                    <th>Est. Time</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody id="scheduledTrafficTableBody">
                  <tr>
                    <td colspan="7" class="text-center py-4 text-muted">
                      No vehicles scheduled yet. Click "Generate & Schedule" to initialize a batch.
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>

            <!-- Live Vehicle Tracking Table -->
            <h6 class="form-label-custom mb-2">Live Vehicle Tracking</h6>
            <div class="table-responsive">
              <table class="table-custom">
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>Type</th>
                    <th>From &rarr; To</th>
                    <th>Route</th>
                    <th>Start</th>
                    <th>Status</th>
                    <th>Signal Wait</th>
                    <th>Travel Time</th>
                  </tr>
                </thead>
                <tbody id="liveTrafficTrackingBody">
                  <!-- Dynamically refreshed -->
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <!-- ====================================================================
           TAB 5: EMERGENCY VEHICLE MANAGEMENT
           ==================================================================== -->
      <section id="view-emergency" class="tab-view d-none">
        <div class="row g-4 mb-4">
          <!-- Section 1: Single Emergency Dispatch -->
          <div class="col-12 col-lg-6">
            <div class="card-glass h-100">
              <div class="card-glass-header">
                <h5 class="card-glass-title text-danger">
                  <i class="bi bi-shield-shaded"></i>
                  Single Emergency Priority Dispatch
                </h5>
                <span class="badge bg-danger">Zero Severity Prompt</span>
              </div>
              <div class="card-glass-body">
                <p class="text-muted small">
                  Every registered Ambulance, Fire Truck, or Police Vehicle is <strong>automatically entitled to green corridor signal priority</strong>.
                </p>
                <div id="emSingleError" class="alert alert-danger d-none py-2 mb-3"></div>

                <div class="row g-2 mb-3">
                  <div class="col-6">
                    <label class="form-label form-label-custom">Vehicle ID</label>
                    <input type="text" id="emSingleId" class="form-control form-control-custom" value="AMB-001">
                  </div>
                  <div class="col-6">
                    <label class="form-label form-label-custom">Emergency Type</label>
                    <select id="emSingleType" class="form-select form-select-custom">
                      <option value="AMBULANCE">Ambulance</option>
                      <option value="FIRE_TRUCK">Fire Truck</option>
                      <option value="POLICE">Police Vehicle</option>
                    </select>
                  </div>
                </div>

                <div class="row g-2 mb-3">
                  <div class="col-6">
                    <label class="form-label form-label-custom">Source Junction</label>
                    <select id="emSingleSrc" class="form-select form-select-custom"></select>
                  </div>
                  <div class="col-6">
                    <label class="form-label form-label-custom">Destination</label>
                    <select id="emSingleDst" class="form-select form-select-custom"></select>
                  </div>
                </div>

                <button id="btnDispatchSingleEmergency" class="btn btn-emergency-custom w-100 py-2">
                  <i class="bi bi-broadcast me-1"></i> Dispatch & Preempt Signals
                </button>
              </div>
            </div>
          </div>

          <!-- Section 2: Two Emergency Vehicles Conflict Resolution -->
          <div class="col-12 col-lg-6">
            <div class="card-glass h-100">
              <div class="card-glass-header flex-wrap gap-2">
                <h5 class="card-glass-title text-warning">
                  <i class="bi bi-intersect"></i>
                  Two Emergencies Location Comparison & FIFO Conflict
                </h5>
                <button id="btnLoadConflictDemoPreset" class="btn btn-sm btn-outline-custom text-warning">
                  Load J6 Conflict Demo
                </button>
              </div>
              <div class="card-glass-body">
                <p class="text-muted small mb-2">
                  Evaluates <strong>Case A</strong> (Same Junction FIFO queue + ID tie-breaker) vs <strong>Case B</strong> (Different Junctions independent coordination).
                </p>
                <div id="emTwoError" class="alert alert-danger d-none py-2 mb-3"></div>
                <div id="emComparisonResultBadge"></div>

                <!-- Vehicle 1 Inputs -->
                <div class="p-2 rounded bg-dark border border-secondary mb-2">
                  <small class="text-info fw-bold d-block mb-1">Emergency Vehicle 1</small>
                  <div class="row g-2">
                    <div class="col-4">
                      <input type="text" id="emV1Id" class="form-control form-control-sm form-control-custom" value="AMB-001">
                    </div>
                    <div class="col-4">
                      <select id="emV1Type" class="form-select form-select-sm form-select-custom">
                        <option value="AMBULANCE">Ambulance</option>
                        <option value="FIRE_TRUCK">Fire Truck</option>
                        <option value="POLICE">Police</option>
                      </select>
                    </div>
                    <div class="col-4">
                      <input type="number" id="emV1Time" class="form-control form-control-sm form-control-custom" value="0" min="0" placeholder="t=">
                    </div>
                    <div class="col-6">
                      <select id="emV1Src" class="form-select form-select-sm form-select-custom"></select>
                    </div>
                    <div class="col-6">
                      <select id="emV1Dst" class="form-select form-select-sm form-select-custom"></select>
                    </div>
                  </div>
                </div>

                <!-- Vehicle 2 Inputs -->
                <div class="p-2 rounded bg-dark border border-secondary mb-3">
                  <small class="text-danger fw-bold d-block mb-1">Emergency Vehicle 2</small>
                  <div class="row g-2">
                    <div class="col-4">
                      <input type="text" id="emV2Id" class="form-control form-control-sm form-control-custom" value="FIRE-001">
                    </div>
                    <div class="col-4">
                      <select id="emV2Type" class="form-select form-select-sm form-select-custom">
                        <option value="FIRE_TRUCK">Fire Truck</option>
                        <option value="AMBULANCE">Ambulance</option>
                        <option value="POLICE">Police</option>
                      </select>
                    </div>
                    <div class="col-4">
                      <input type="number" id="emV2Time" class="form-control form-control-sm form-control-custom" value="0" min="0" placeholder="t=">
                    </div>
                    <div class="col-6">
                      <select id="emV2Src" class="form-select form-select-sm form-select-custom"></select>
                    </div>
                    <div class="col-6">
                      <select id="emV2Dst" class="form-select form-select-sm form-select-custom"></select>
                    </div>
                  </div>
                </div>

                <button id="btnDispatchTwoEmergencies" class="btn btn-warning w-100 fw-bold py-2 text-dark">
                  <i class="bi bi-shield-check me-1"></i> Compare Locations & Execute Preemption
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- FIFO Emergency Queue Monitoring -->
        <div class="card-glass mb-4">
          <div class="card-glass-header">
            <h5 class="card-glass-title">
              <i class="bi bi-list-ol text-danger"></i>
              Live FIFO Emergency Preemption Request Queue
            </h5>
          </div>
          <div class="card-glass-body p-0">
            <div class="table-responsive">
              <table class="table-custom">
                <thead>
                  <tr>
                    <th>Queue Pos</th>
                    <th>Vehicle ID</th>
                    <th>Type</th>
                    <th>Junction</th>
                    <th>Approach Direction</th>
                    <th>Request Time</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody id="emQueueTableBody">
                  <!-- Dynamically populated -->
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Safety Sequence Invariant Card -->
        <div class="card-glass">
          <div class="card-glass-header">
            <h5 class="card-glass-title text-info">
              <i class="bi bi-shield-lock-fill"></i>
              Signal Transition Sequence & Safety Verification
            </h5>
          </div>
          <div class="card-glass-body">
            <div class="row g-3">
              <div class="col-12 col-md-3">
                <div class="p-3 rounded bg-dark border border-secondary text-center">
                  <span class="badge bg-warning text-dark mb-1">Phase 1: CLEARING</span>
                  <div class="small text-white">Active GREEN &rarr; YELLOW (1s)</div>
                  <small class="text-muted">Conflicting approaches held at RED</small>
                </div>
              </div>
              <div class="col-12 col-md-3">
                <div class="p-3 rounded bg-dark border border-secondary text-center">
                  <span class="badge bg-danger mb-1">Phase 2: ALL-RED</span>
                  <div class="small text-white">All 4 Approaches RED (1s)</div>
                  <small class="text-muted">Clears all intersection traffic</small>
                </div>
              </div>
              <div class="col-12 col-md-3">
                <div class="p-3 rounded bg-dark border border-secondary text-center">
                  <span class="badge bg-success mb-1">Phase 3: EMERGENCY GREEN</span>
                  <div class="small text-white">Emergency Direction GREEN</div>
                  <small class="text-muted">Held until vehicle clears junction</small>
                </div>
              </div>
              <div class="col-12 col-md-3">
                <div class="p-3 rounded bg-dark border border-secondary text-center">
                  <span class="badge bg-primary mb-1">Phase 4: RESTORING</span>
                  <div class="small text-white">YELLOW &rarr; Next Normal GREEN</div>
                  <small class="text-muted">Cyclic round-robin restored</small>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ====================================================================
           TAB 6: TRAFFIC SIGNAL MONITORING
           ==================================================================== -->
      <section id="view-signals" class="tab-view d-none">
        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
          <div>
            <h4 class="text-white fw-bold mb-0">Traffic Signal Monitoring</h4>
            <small class="text-muted">Real-time status for all 12 Coimbatore Junction Traffic Signals</small>
          </div>
          <div class="d-flex gap-2">
            <span class="badge phase-normal">NORMAL</span>
            <span class="badge phase-clearing">CLEARING</span>
            <span class="badge phase-allred">ALL_RED</span>
            <span class="badge phase-emergency">EMERGENCY_GREEN</span>
            <span class="badge phase-restoring">RESTORING</span>
          </div>
        </div>

        <div class="row" id="signalsGridContainer">
          <!-- Dynamically populated with 12 junction cards -->
        </div>
      </section>

      <!-- ====================================================================
           TAB 7: TRAFFIC EVENTS
           ==================================================================== -->
      <section id="view-events" class="tab-view d-none">
        <div class="card-glass">
          <div class="card-glass-header flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <h5 class="card-glass-title mb-0 me-3">
                <i class="bi bi-clock-history text-info"></i>
                Traffic Event Log Stream
              </h5>
              <div class="btn-group btn-group-sm" role="group">
                <button class="btn btn-outline-custom event-filter-btn active" data-filter="all">All</button>
                <button class="btn btn-outline-custom event-filter-btn" data-filter="emergency">Emergency</button>
                <button class="btn btn-outline-custom event-filter-btn" data-filter="signal">Signals</button>
                <button class="btn btn-outline-custom event-filter-btn" data-filter="traffic">Traffic</button>
                <button class="btn btn-outline-custom event-filter-btn" data-filter="system">System</button>
              </div>
            </div>
            
            <div class="d-flex align-items-center gap-2">
              <input type="text" id="eventsSearchInput" class="form-control form-control-sm form-control-custom" placeholder="Search events..." style="width: 180px;">
              <button id="btnTriggerRoadClosure" class="btn btn-sm btn-outline-danger" title="Simulate an accident closing Gandhipuram <-> Ukkadam">
                <i class="bi bi-exclamation-octagon me-1"></i> Close Road
              </button>
              <button id="btnTriggerHeavyTraffic" class="btn btn-sm btn-outline-warning" title="Simulate heavy congestion on Ukkadam <-> Singanallur">
                <i class="bi bi-cone-striped me-1"></i> Heavy Traffic
              </button>
            </div>
          </div>
          <div class="card-glass-body p-0" id="eventsFullStreamContainer" style="max-height: 600px; overflow-y: auto;">
            <!-- Dynamically populated -->
          </div>
        </div>
      </section>

      <!-- ====================================================================
           TAB 8: REPORTS & AUTOMATED TESTS
           ==================================================================== -->
      <section id="view-reports" class="tab-view d-none">
        <!-- Summary Cards -->
        <div class="row g-3 mb-4">
          <div class="col-12 col-md-3">
            <div class="metric-card">
              <div class="metric-label">Normal Signal Wait</div>
              <div id="repAvgWaitNormal" class="metric-value">--</div>
              <div class="metric-sub">Simulation ticks</div>
            </div>
          </div>
          <div class="col-12 col-md-3">
            <div class="metric-card emergency">
              <div class="metric-label">Emergency Wait Time</div>
              <div id="repAvgWaitEmergency" class="metric-value">0.00 ticks</div>
              <div class="metric-sub">Zero-wait green corridor</div>
            </div>
          </div>
          <div class="col-12 col-md-3">
            <div class="metric-card success">
              <div class="metric-label">Avg Simulated Travel</div>
              <div id="repAvgTravel" class="metric-value">--</div>
              <div class="metric-sub">Average trip duration</div>
            </div>
          </div>
          <div class="col-12 col-md-3">
            <div class="metric-card">
              <div class="metric-label">Emergencies Completed</div>
              <div id="repEmergencyCompleted" class="metric-value">0</div>
              <div class="metric-sub">Corridor priority verified</div>
            </div>
          </div>
        </div>

        <!-- Charts Row -->
        <div class="row g-4 mb-4">
          <div class="col-12 col-lg-6">
            <div class="card-glass h-100">
              <div class="card-glass-header">
                <h5 class="card-glass-title">
                  <i class="bi bi-bar-chart-fill text-primary"></i>
                  Signal Waiting Time Comparison (Normal vs Priority)
                </h5>
              </div>
              <div class="card-glass-body" style="height: 280px;">
                <canvas id="chartWaitComparisonCanvas"></canvas>
              </div>
            </div>
          </div>

          <div class="col-12 col-lg-6">
            <div class="card-glass h-100">
              <div class="card-glass-header">
                <h5 class="card-glass-title">
                  <i class="bi bi-graph-up text-info"></i>
                  Simulated Travel Times by Vehicle (Ticks)
                </h5>
              </div>
              <div class="card-glass-body" style="height: 280px;">
                <canvas id="chartTravelTimesCanvas"></canvas>
              </div>
            </div>
          </div>
        </div>

        <!-- Automated Test Runner matching Main.java -->
        <div class="card-glass">
          <div class="card-glass-header flex-wrap gap-2">
            <div>
              <h5 class="card-glass-title">
                <i class="bi bi-check2-square text-success"></i>
                Automated Test Suite Runner (Java Logic Parity)
              </h5>
              <small class="text-muted">Executes tests for Dijkstra, Road Closures, Signal Safety Invariant, and Multi-Emergency Conflict Resolution.</small>
            </div>
            <button id="btnRunAutomatedTests" class="btn btn-primary-custom">
              <i class="bi bi-play-circle me-1"></i> Run Automated Tests
            </button>
          </div>
          <div class="card-glass-body" id="testResultsContainer">
            <div class="text-center py-4 text-muted">
              Click <strong>"Run Automated Tests"</strong> to verify all 6 test suites against the live simulation algorithms.
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>

  <!-- Modal: Road Segment Action -->
  <div class="modal fade" id="roadActionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content card-glass" style="background: #0d1936; border: 1px solid var(--border-strong);">
        <div class="modal-header border-bottom border-secondary border-opacity-25">
          <h5 class="modal-title text-white" id="roadModalTitle">Road Segment Action</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="roadModalA">
          <input type="hidden" id="roadModalB">

          <div class="mb-3">
            <label class="form-label form-label-custom">Current Road Status</label>
            <div class="d-flex align-items-center justify-content-between p-2 rounded bg-dark border border-secondary">
              <span class="text-white">Status: <strong id="roadModalStatus">OPEN</strong></span>
              <button id="btnRoadModalToggleClosure" class="btn btn-sm btn-outline-danger">
                Toggle Closure
              </button>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label form-label-custom">Congestion Level</label>
            <select id="roadModalTrafficSelect" class="form-select form-select-custom">
              <option value="LIGHT">LIGHT (1.0x - Normal)</option>
              <option value="MODERATE">MODERATE (1.5x Travel Time)</option>
              <option value="HEAVY">HEAVY (2.5x Travel Time)</option>
            </select>
          </div>
        </div>
        <div class="modal-footer border-top border-secondary border-opacity-25">
          <button type="button" class="btn btn-outline-custom" data-bs-dismiss="modal">Close</button>
          <button type="button" id="btnRoadModalApplyTraffic" class="btn btn-primary-custom">Apply Traffic Level</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal: Backend API Configuration -->
  <div class="modal fade" id="backendConfigModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content card-glass" style="background: #0d1936; border: 1px solid var(--border-strong);">
        <div class="modal-header border-bottom border-secondary border-opacity-25">
          <h5 class="modal-title text-white">
            <i class="bi bi-hdd-network text-info me-2"></i>
            Java Spring Boot REST API Connection
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p class="text-muted small">
            The frontend connects to a Java Spring Boot REST API or built-in Java HTTP Bridge. If no server is running, the in-browser simulation engine runs the exact same algorithms offline with zero data loss.
          </p>

          <div class="mb-3">
            <label class="form-label form-label-custom">Backend REST URL</label>
            <input type="text" id="backendUrlInput" class="form-control form-control-custom" value="http://localhost:8080">
            <small class="text-muted">Default: <code>http://localhost:8080</code></small>
          </div>

          <div class="p-3 rounded bg-dark border border-secondary mb-2" style="font-size: 0.8rem;">
            <strong class="text-info d-block mb-1">Available Endpoints:</strong>
            <ul class="list-unstyled mb-0 text-muted">
              <li><code>GET /api/network/junctions</code></li>
              <li><code>GET /api/network/roads</code></li>
              <li><code>POST /api/routes/find</code></li>
              <li><code>POST /api/traffic/generate</code></li>
              <li><code>POST /api/emergency/request</code></li>
              <li><code>GET /api/signals</code></li>
            </ul>
          </div>
        </div>
        <div class="modal-footer border-top border-secondary border-opacity-25">
          <button type="button" class="btn btn-outline-custom" data-bs-dismiss="modal">Cancel</button>
          <button type="button" id="btnSaveBackendUrl" class="btn btn-primary-custom">Connect & Save</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast Notifications Container -->
  <div id="toastContainer" class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1090;"></div>

  <!-- Scripts: Bootstrap 5, Chart.js, Modular Application Files -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

  <script src="js/api.js"></script>
  <script src="js/network.js"></script>
  <script src="js/dashboard.js"></script>
  <script src="js/routes.js"></script>
  <script src="js/traffic.js"></script>
  <script src="js/emergency.js"></script>
  <script src="js/signals.js"></script>
  <script src="js/events.js"></script>
  <script src="js/reports.js"></script>
  <script src="js/app.js"></script>
</body>
</html>
